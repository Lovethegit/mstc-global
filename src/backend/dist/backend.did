   "type": text;
 };
type AppNotification = 
 record {
   appName: text;
   createdAt: int;
   id: nat;
   isRead: bool;
   message: text;
   priority: text;
   targetRole: text;
   title: text;
 };
type Announcement = 
 record {
   bgColor: text;
   createdAt: int;
   ctaText: text;
   ctaUrl: text;
   expiresAt: opt int;
   id: text;
   isActive: bool;
   message: text;
   scheduledAt: opt int;
   title: text;
 };
type AnniversaryReminder = 
 record {
   clientName: text;
   createdAt: int;
   email: text;
   id: text;
   notes: text;
   phone: text;
   reminderDate: text;
   reminderType: text;
 };
type AiDecisionType = 
 variant {
   ANOMALY_FLAGGED;
   BOOKING_CONFIRMED;
   COMMISSION_CALCULATED;
   CONTENT_PUBLISHED;
   FOLLOW_UP_SENT;
   LEAD_SCORED;
   MINOR_UI_FIX;
   OTHER;
   PROPERTY_PUBLISHED;
   SECURITY_BLOCKED;
 };
type AiDecision = 
 record {
   actionTaken: text;
   agentName: text;
   confidenceScore: nat;
   decisionType: AiDecisionType;
   description: text;
   id: text;
   outcome: text;
   reversalReason: text;
   reversed: bool;
   reversedAt: opt int;
   reversible: bool;
   timestamp: int;
 };
type AgentActivity = 
 record {
   action: text;
   agentId: text;
   agentName: text;
   cluster: text;
   result: text;
   status: text;
   timestamp: int;
 };
type AdminStaffMember = 
 record {
   accessLevel: text;
   accessSections: vec text;
   canDelete: bool;
   canExport: bool;
   createdAt: int;
   email: text;
   id: text;
   isActive: bool;
   lastLogin: opt int;
   loginId: text;
   name: text;
   passwordHash: text;
   phone: text;
   role: text;
 };
type AISystemConfig = 
 record {
   activeAgents: nat;
   activeProvider: text;
   claudeKeySet: bool;
   fallbackOrder: vec text;
   geminiKeySet: bool;
   openAIKeySet: bool;
   totalAgents: nat;
 };
type AIInsight = 
 record {
   agentId: text;
   content: text;
   createdAt: text;
   id: text;
   priority: text;
   status: text;
   title: text;
 };
type AIAgent = 
 record {
   actionsLog: vec text;
   category: text;
   config: text;
   description: text;
   id: text;
   isActive: bool;
   lastAction: text;
   name: text;
   parentId: opt text;
   tier: text;
 };
type AIActivityEntry = 
 record {
   actionType: text;
   agentId: text;
   agentName: text;
   count: nat;
   result: text;
   timestamp: text;
 };
